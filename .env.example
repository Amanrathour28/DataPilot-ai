# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot_secret
POSTGRES_DB=datapilot
DATABASE_URL=postgresql+asyncpg://datapilot:datapilot_secret@localhost:5432/datapilot

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_hex_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=DataPilot AI
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# ─── Ollama (Phase 2+) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

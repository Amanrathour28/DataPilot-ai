# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot_secret
POSTGRES_DB=datapilot
DATABASE_URL=postgresql+asyncpg://datapilot:datapilot_secret@localhost:5432/datapilot

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_hex_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/v1/auth/google/callback

# Frontend Google Client ID (Vite prefix)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Email Service (Password Reset & Notifications) ───────────────────────────
# Options: "console" (development logging), "resend", "sendgrid", "smtp"
EMAIL_PROVIDER=console
EMAIL_FROM=DataPilot AI <noreply@datapilot.ai>

# If using Resend:
RESEND_API_KEY=re_your_resend_api_key

# If using SendGrid:
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# If using SMTP:
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASSWORD=your_smtp_password
SMTP_TLS=true

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=DataPilot AI
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://datapilot-ai.vercel.app
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# ─── Cloud LLM (Groq Cloud — Recommended for Ultra-Fast Agent Swarms) ──────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Optional OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Ollama (Local LLM Fallback) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

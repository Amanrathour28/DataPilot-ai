# ==============================================================================
# DataPilot AI — Backend Environment Variables
# Copy to .env for local development or configure in Vercel / Cloud Dashboard.
# DO NOT COMMIT REAL SECRETS OR API KEYS TO GIT.
# ==============================================================================

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# In Neon Console: Copy your Pooled Connection String (starts with postgresql:// or postgres://)
# Example: postgresql://neondb_owner:npg_xyz@ep-cool-lake-123-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://datapilot:datapilot_secret@localhost:5432/datapilot

# ─── App Configuration ────────────────────────────────────────────────────────
APP_NAME=DataPilot AI
APP_ENV=production
DEBUG=false

# ─── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend URLs. Wildcard https://*.vercel.app is enabled by default.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-app.vercel.app

# ─── Security & Authentication ────────────────────────────────────────────────
# Generate a strong 32+ character random secret (e.g. `openssl rand -hex 32`)
SECRET_KEY=change_me_to_a_secure_random_hex_string_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Storage (Serverless Ephemeral Uploads) ───────────────────────────────────
# Automatically defaults to /tmp/uploads in Vercel serverless environment
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# ─── LLM Providers (Optional for Autonomous Agent Reasoning) ──────────────────
# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Option B: Groq (Fast & Free-tier friendly)
GROQ_API_KEY=

# Option C: Local Ollama (Development only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# ─── Cache / Queue (Optional) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
